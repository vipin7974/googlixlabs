# Live visitor counter (components/LiveVisitors.tsx + app/api/presence/route.ts)
#
# Free Upstash Redis database — https://console.upstash.com
#   1. Sign up (free, no card required) and create a Redis database
#      (any region close to your users; "Global" works fine too).
#   2. On the database's page, copy the "REST API" URL and token
#      (NOT the Redis:// connection string — this project uses the
#      REST client so it works on Netlify/edge functions).
#   3. Put the real values in a new file named .env.local (already
#      gitignored, never commit real secrets) for local dev, and add
#      the same two variables in your host's dashboard (Netlify:
#      Site settings -> Environment variables) for production.
#
# Without these two set, the live visitor badge simply doesn't render —
# nothing breaks, it just stays hidden until Upstash is configured.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
